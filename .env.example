# Postgres for accounts, essays and uploaded books. On Vercel + Neon, `vercel env pull .env.local` fills these in.
# DATABASE_URL is used by the app (the pooled connection on Neon); `npm run db:migrate` prefers DATABASE_URL_UNPOOLED (direct).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# New accounts allowed per client IP per hour (0 turns the limit off; loopback is always exempt).
# SIGNUP_LIMIT_PER_HOUR=5

# No server key is needed: connect your own key in the app's AI settings.
# Leave false when sharing the app. Visitors must fund their own requests.
AI_ALLOW_SERVER_KEY=false

# Optional: for a PRIVATE personal instance, set AI_ALLOW_SERVER_KEY=true
# and configure ONE provider below. Never use NEXT_PUBLIC_ for API keys.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional absolute path to a directory containing data/antigone.xml.
# FINALS_DATA_ROOT=/absolute/path/to/finals-data

# Free tier on the server key above, always with the economy model. Both are required; either at 0 keeps it off.
# AI_FREE_CHECKS_PER_ACCOUNT: checks per signed-in account per calendar month. A check is one click, however many requests it makes.
# AI_FREE_BUDGET_USD: the most free checks may cost in a month across every account; when it is spent they pause until the 1st.
# Independent of AI_ALLOW_SERVER_KEY, which is the unlimited private-instance switch.
AI_FREE_CHECKS_PER_ACCOUNT=0
AI_FREE_BUDGET_USD=0

# Signs shareable grade-report links (any long random string, e.g. `openssl rand -hex 32`). Rotating it breaks existing links.
SHARE_SECRET=
